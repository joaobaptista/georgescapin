# ==============================================================================
# Git Ignore - Clínica Dr. George Scapin
# ==============================================================================

# Environment & Credentials
.env
.env.*
!.env.example
auth.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs and Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.settings/
.buildpath
*.swp
*.swo
*~
.zed/
.cursor/
.codex/
.nova/

# Dependencies & Package Managers
/vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
composer.phar

# Logs and Temporary / Cache Files
*.log
logs/
error_log
cache/
tmp/
temp/
.cache/
.phpunit.cache/
.phpunit.result.cache
.phpactor.json

# Backups and Archives
*.bak
*.backup
*.tmp
*.zip
*.tar.gz
*.sql.gz
build/

# Dumps e bancos locais: contêm dados de pacientes (LGPD). Schemas e seeds
# (schema.sql, seed.sql) continuam versionados.
backup*.sql
*.sqlite
*.sqlite3
*.sqlite-journal
*.db

# Uploads (ignora arquivos gerados por upload dinâmico no CMS, mantendo .htaccess e .gitkeep)
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep

# Storage e Sessões Locais de Fallback
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/backups/
