APP_ENV=production
APP_URL=https://sistema.exemplo.com.br
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nuva
DB_USERNAME=nuva
DB_PASSWORD=

# Sessões: validade máxima e tempo de inatividade
SESSION_LIFETIME_HOURS=12
SESSION_IDLE_MINUTES=120

# IPs dos proxies/balanceadores (vírgula). Só deles se aceitam X-Forwarded-For
# e X-Forwarded-Proto. Vazio = conexão direta. Nunca use * sem um proxy na frente.
TRUSTED_PROXIES=
